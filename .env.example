# Copy this file to ".env" and fill in real values before starting docker-compose.
# The actual ".env" is gitignored so secrets never get committed.

# --- Postgres (used by docker-compose for the database + backend) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=tour_planner

# --- Backend secrets (used by Spring Boot at runtime) ---
# JWT signing secret. Any random ~32-char string works — must stay private.
JWT_SECRET=changeme-pick-something-long-and-random

# OpenRouteService API key. Free key at https://openrouteservice.org/.
OPENROUTESERVICE_APIKEY=
