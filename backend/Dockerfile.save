  1 # Stage 1: Build                                                                                                                                                                                                                      │
│  2 FROM maven:3.9.6-eclipse-temurin-21 AS build                                                                                                                                                                                          │
│  3 WORKDIR /app                                                                                                                                                                                                                          │
│  4                                                                                                                                                                                                                                       │
│  5 # Copy pom.xml and download dependencies (cached layer)                                                                                                                                                                               │
│  6 COPY pom.xml .                                                                                                                                                                                                                        │
│  7 RUN mvn dependency:go-offline -B                                                                                                                                                                                                      │
│  8                                                                                                                                                                                                                                       │
│  9 # Copy source code and build                                                                                                                                                                                                          │
│ 10 COPY src ./src                                                                                                                                                                                                                        │
│ 11 RUN mvn package -DskipTests                                                                                                                                                                                                           │
│ 12                                                                                                                                                                                                                                       │
│ 13 # Stage 2: Run                                                                                                                                                                                                                        │
│ 14 FROM eclipse-temurin:21-jre-jammy                                                                                                                                                                                                     │
│ 15 WORKDIR /app                                                                                                                                                                                                                          │
│ 16                                                                                                                                                                                                                                       │
│ 17 # Copy the built jar from the build stage                                                                                                                                                                                             │
│ 18 COPY --from=build /app/target/*.jar app.jar                                                                                                                                                                                           │
│ 19                                                                                                                                                                                                                                       │
│ 20 # Expose the port your app runs on (default Spring Boot is 8080)                                                                                                                                                                      │
│ 21 EXPOSE 8080                                                                                                                                                                                                                           │
│ 22                                                                                                                                                                                                                                       │
│ 23 # Run the application                                                                                                                                                                                                                ENTRYPOINT ["java", "-jar", "app.jar"]  
